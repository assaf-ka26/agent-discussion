# ~/.agent-discussion/config.env: read by run.sh on every run
CHANNEL_ID=C0XXXXXXXXX          # the shared agents channel (Slack channel ID)
OWNER_ID=U0XXXXXXXXX            # your Slack user ID: the agent answers only when this is tagged
OWNER_NAME=Dana                 # used in the "🤖 Dana's agent:" prefix
WORKDIR="$HOME/work/my-project" # project whose CLAUDE.md, memory and repos the answer stage uses
INTERVAL_MIN=30                 # keep in sync with the scheduler (launchd StartInterval / cron)
MODEL=sonnet                    # answer stage
# TRIAGE_MODEL=haiku            # LLM triage (used when there's no SLACK_TOKEN); a yes/no check
WORK_DAYS="1 2 3 4 5"           # date +%u: Mon=1 … Sun=7 (Sun–Thu week: "7 1 2 3 4"); empty = every day
WORK_HOURS="8-19"               # runs from 08:00 to 18:59; empty = all day
# OPEN_TTL_HOURS=24             # stop watching an open thread after this long without activity
# POLL=60                       # after an answer: re-check after this many seconds ...
# IDLE_LIMIT=60                 # ... and stop after this many quiet seconds (default: one re-check)
# ANSWER_BUILTIN_TOOLS=Read,Grep,Glob,Bash   # built-in tools the answer stage loads (add e.g. WebFetch if you allow it)
# TRIAGE_CAP=0.50               # stop for a runaway triage call (--max-budget-usd)
# ANSWER_CAP=5                  # stop for a runaway answer call
# SLACK_SERVER=slack-agents     # name of the user-scope Slack MCP server
# Free triage: put `export SLACK_TOKEN=xoxp-…` in env.sh (not here). See assets/slack-app-manifest.yml.
# CLAUDE_BIN=/path/to/claude    # if the CLI isn't in a standard place
# Extra read-only tools for the answer stage (comma-separated permission rules), e.g.:
# EXTRA_TOOLS="Bash(psql:*),Bash(aws logs:*)"
# EXTRA_DENIED="Read(~/secrets/**)"
# Guard (guard.py) scope. The answer stage can read only WORKDIR plus these folders (colon-separated):
# READ_ROOTS="$HOME/.claude/projects/-Users-dana-work-my-project/memory:$HOME/notes/decisions"
# Never readable, even inside WORKDIR (colon-separated; keep them git-ignored so a repo-wide search skips them):
# SECRET_PATHS="$HOME/work/my-project/secrets"
# Pin gh to one repo (gh -R and other repos' URLs are then blocked):
# GH_REPO=acme/my-project
# Headless runs skip ~/.claude/settings.json and user-scope MCP servers (see SKILL.md, section 4).
# Pass the MCP servers the answer stage needs as extra config files:
# EXTRA_MCP_CONFIGS="--mcp-config $HOME/.agent-discussion/db-mcp.json"
